{
  "$description": "Aho imóveis: paleta 2026 (aprovada). Fonte: docs/02-cores.md",
  "cor": {
    "branco-mineral": { "$type": "color", "$value": "#FAF8F4", "$description": "Fundo principal · 50%" },
    "pedra-neutra": { "$type": "color", "$value": "#D8DACD", "$description": "Fundo secundário, bordas · 30%" },
    "preto-uva-passa": { "$type": "color", "$value": "#1C211E", "$description": "Texto e logo · 9%" },
    "cinza-ardosia": { "$type": "color", "$value": "#59625A", "$description": "Texto de apoio, fundos de seção · 8%" },
    "verde-folha": { "$type": "color", "$value": "#4F7A45", "$description": "Cor de marca, ações · 2%" },
    "verde-vibrante": { "$type": "color", "$value": "#DBFF00", "$description": "Destaque, somente sobre escuro · 1%" }
  },
  "papel": {
    "fundo": { "$type": "color", "$value": "{cor.branco-mineral}" },
    "fundo-secundario": { "$type": "color", "$value": "{cor.pedra-neutra}" },
    "borda": { "$type": "color", "$value": "{cor.pedra-neutra}" },
    "texto": { "$type": "color", "$value": "{cor.preto-uva-passa}" },
    "texto-apoio": { "$type": "color", "$value": "{cor.cinza-ardosia}" },
    "texto-invertido": { "$type": "color", "$value": "{cor.branco-mineral}" },
    "acao": { "$type": "color", "$value": "{cor.verde-folha}" },
    "acao-texto": { "$type": "color", "$value": "{cor.branco-mineral}" },
    "destaque": { "$type": "color", "$value": "{cor.verde-vibrante}" }
  }
}
